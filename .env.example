# Required for file-specific Google Drive OAuth and Picker access
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_PICKER_API_KEY=
# Numeric Google Cloud project number, not the project name.
GOOGLE_PICKER_APP_ID=

# Use managed for a centrally hosted multi-tenant service. This changes the
# settings presentation only; authorization remains enforced by the backend.
DEPLOYMENT_MODE=self_hosted

# Must exactly match the Web OAuth client configuration. Leave blank locally to
# derive it from PUBLIC_URL.
GOOGLE_OAUTH_REDIRECT_URI=
# Optional separate browser UI origin, for example http://localhost:5173 when
# running Vite. Leave blank when the backend serves the UI itself.
FRONTEND_URL=
PUBLIC_URL=http://localhost:8000
# Complete comma-separated allowlists used by the MCP transport. Replacing
# either value replaces the whole corresponding list.
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,[::1],[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://127.0.0.1:*,http://localhost,http://localhost:*,http://[::1],http://[::1]:*

# Change these outside local development.
POSTGRES_DATABASE=settra
POSTGRES_USER=settra
POSTGRES_PASSWORD=settra-dev-password
# Optional product-database overrides. Blank values inherit POSTGRES_* above.
APP_DB_HOST=
APP_DB_PORT=
APP_DB_DATABASE=
APP_DB_USER=
APP_DB_PASSWORD=
APP_DB_SCHEMA=settra_app
SECRET_KEY=dev-secret-change-me

# Account registration and browser sessions. Leave the secure-cookie setting
# blank to infer it from PUBLIC_URL, or set it explicitly when behind a proxy.
REGISTRATION_ENABLED=true
APP_SESSION_TTL_SECONDS=2592000
APP_SESSION_COOKIE_SECURE=

# MCP access is always user-authorized in a multi-tenant deployment.
MCP_OAUTH_ENABLED=true

CUBE_API_SECRET=cube-dev-secret-change-me
