# Required for Google Sheets OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_PICKER_API_KEY=
# Numeric Google Cloud project number, not the project name.
GOOGLE_PICKER_APP_ID=

# Must exactly match the Web OAuth client configuration. Leave blank locally to
# derive it from SETTRA_PUBLIC_URL.
GOOGLE_OAUTH_REDIRECT_URI=
# Optional separate browser UI origin, for example http://localhost:5173 when
# running Vite. Leave blank when the backend serves the UI itself.
SETTRA_FRONTEND_URL=
SETTRA_PUBLIC_URL=http://localhost:8000
# Complete comma-separated allowlists used by the MCP transport. Replacing
# either value replaces the whole corresponding list.
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,[::1],[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://127.0.0.1:*,http://localhost,http://localhost:*,http://[::1],http://[::1]:*

# Change these outside local development.
POSTGRES_DATABASE=settra
POSTGRES_USER=settra
POSTGRES_PASSWORD=settra-dev-password
# Optional product-database overrides. Blank values inherit POSTGRES_* above.
SETTRA_DB_HOST=
SETTRA_DB_PORT=
SETTRA_DB_DATABASE=
SETTRA_DB_USER=
SETTRA_DB_PASSWORD=
SETTRA_DB_SCHEMA=settra_app
SECRET_KEY=dev-secret-change-me

CUBE_API_SECRET=cube-dev-secret-change-me
